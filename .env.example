# ==============================================================================
# DIGITAL DOCUMENT VAULT - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and adjust values for your local or production deployment.

# Database Settings
POSTGRES_DB=vaultdb
POSTGRES_USER=vaultadmin
POSTGRES_PASSWORD=vault_secure_password_2026
POSTGRES_PORT=5432

# Backend Application Settings
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=docker

# Storage Configuration (Private storage path outside web root)
VAULT_STORAGE_LOCAL_BASE_DIR=/vault/storage
VAULT_STORAGE_MAX_FILE_SIZE_BYTES=26214400 # 25 MB

# Security Policies
VAULT_SECURITY_SESSION_TIMEOUT_MINUTES=30
VAULT_SECURITY_MAX_FAILED_LOGIN_ATTEMPTS=5
VAULT_SECURITY_ACCOUNT_LOCK_MINUTES=15
VAULT_SECURITY_PASSWORD_MIN_LENGTH=12

# Frontend Port
FRONTEND_PORT=3000
